# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Cloud
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key
GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key

# Weather API
EXPO_PUBLIC_WEATHER_API_KEY=your-weather-api-key

# Firebase App Distribution
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ANDROID_APP_ID=1:1234567890:android:abcdef123456
FIREBASE_TESTER_GROUPS=testers
